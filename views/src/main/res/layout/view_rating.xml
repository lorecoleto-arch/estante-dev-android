<?xml version="1.0" encoding="utf-8"?>
<!-- Componente reutilizável: inflado pela classe RatingView (que é um LinearLayout). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageButton
        android:id="@+id/star1"
        style="@style/Widget.Estante.Star" />

    <ImageButton
        android:id="@+id/star2"
        style="@style/Widget.Estante.Star" />

    <ImageButton
        android:id="@+id/star3"
        style="@style/Widget.Estante.Star" />

    <ImageButton
        android:id="@+id/star4"
        style="@style/Widget.Estante.Star" />

    <ImageButton
        android:id="@+id/star5"
        style="@style/Widget.Estante.Star" />
</merge>
